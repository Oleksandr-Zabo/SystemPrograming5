<Window x:Class="SystemPrograming5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Copy App" Height="350" Width="550">
    <Grid>
        <StackPanel Margin="10">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Source File:" Width="100"/>
                <TextBox Name="SourcePath" Width="300"/>
                <Button Content="Browse" Width="75" Click="BrowseSource_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Destination:" Width="100"/>
                <TextBox Name="DestinationPath" Width="300"/>
                <Button Content="Browse" Width="75" Click="BrowseDestination_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Threads Count:" Width="100"/>
                <TextBox Name="ThreadCount" Width="50"/>
            </StackPanel>
            <ProgressBar Name="ProgressBar" Height="25" Margin="5"/>
            <StackPanel Orientation="Horizontal" Margin="5">
                <Button Content="Start" Width="75" Click="StartCopy_Click" Margin="5"/>
                <Button Content="Pause" Width="75" Click="PauseCopy_Click" Margin="5"/>
                <Button Content="Resume" Width="75" Click="ResumeCopy_Click" Margin="5"/>
                <Button Content="Stop" Width="75" Click="StopCopy_Click" Margin="5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>