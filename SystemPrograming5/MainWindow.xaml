<Window x:Class="SystemPrograming5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Factorial Calculator" Height="250" Width="400">
    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="Enter a number:" Margin="5"/>
            <TextBox Name="InputNumber" Margin="5"/>
            <TextBlock Text="Enter a power:" Margin="5"/>
            <TextBox Name="PowerNumber" Margin="5"/>
            <Button Content="Calculate Power" Margin="5" Click="CalculatePower_Click"/>
            <TextBlock Text="Result:" Margin="5"/>
            <TextBlock Name="ResultBlock" Margin="5" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>