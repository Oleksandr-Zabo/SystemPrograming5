<Window x:Class="SystemPrograming5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Text Analyzer" Height="300" Width="400">
    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="Enter text:" Margin="5"/>
            <TextBox Name="InputText" Height="100" TextWrapping="Wrap" AcceptsReturn="True" Margin="5"/>
            <Button Content="Analyze Text" Margin="5" Width="100" Click="AnalyzeText_Click"/>
            <TextBlock Text="Results:" Margin="5"/>
            <TextBlock Name="ResultBlock" Margin="5" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>