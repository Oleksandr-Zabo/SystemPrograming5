<Window x:Class="SystemProgramming5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SystemProgramming5"
        mc:Ignorable="d"
        Title="Thread Manager" Height="450" Width="700">
    <Grid>
        <StackPanel>
            <TextBlock Text="Log:" FontWeight="Bold"/>
            <TextBox Name="LogBox" Height="200" VerticalScrollBarVisibility="Auto" IsReadOnly="True" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="5">
                <Button Content="Start Numbers" Width="150" Click="StartNumbers_Click"/>
                <Button Content="Start Letters" Width="150" Margin="5,0" Click="StartLetters_Click"/>
                <Button Content="Start Symbols" Width="150" Click="StartSymbols_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <Button Content="Set High Priority" Width="150" Click="SetHighPriority_Click"/>
                <Button Content="Set Normal Priority" Width="150" Margin="5,0" Click="SetNormalPriority_Click"/>
                <Button Content="Set Low Priority" Width="150" Click="SetLowPriority_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>