<Window x:Class="SystemPrograming5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SystemPrograming5"
        mc:Ignorable="d"
        Title="File Copy App" Height="300" Width="500">
    <Grid>
        <StackPanel Margin="10">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Source File:" Width="100"/>
                <TextBox Name="SourcePath" Width="300"/>
                <Button Content="Browse" Width="75" Click="BrowseSource_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Destination:" Width="100"/>
                <TextBox Name="DestinationPath" Width="300"/>
                <Button Content="Browse" Width="75" Click="BrowseDestination_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Threads Count:" Width="100"/>
                <TextBox Name="ThreadCount" Width="50"/>
            </StackPanel>
            <ProgressBar Name="ProgressBar" Height="25" Margin="5"/>
            <Button Content="Start" Width="100" HorizontalAlignment="Center" Click="StartCopy_Click"/>
        </StackPanel>
    </Grid>
</Window>